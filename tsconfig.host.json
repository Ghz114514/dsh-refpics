{
  // Host-half program (node process side): tool registration, provider
  // adapters, and the settings section. SDK types resolve from the
  // @deepseek-ai/* npm packages declared in devDependencies (official NPM
  // SDK), never from a source checkout.
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "lib": ["ES2024"],
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "types": ["node"]
  },
  "include": [
    "src/index.ts",
    "src/config.ts",
    "src/providers.ts",
    "src/routes.ts",
    "src/core/**/*.ts"
  ]
}
